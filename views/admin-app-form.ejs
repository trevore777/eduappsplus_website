<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= item?'Edit':'Add' %> App — EDU Apps Plus</title><link rel="stylesheet" href="/css/app.css"></head><body class="admin-bg"><header class="admin-top"><a class="brand" href="/admin/apps"><span class="brand-mark">EDU</span><span>Apps Plus</span></a><a class="ghost-btn" href="/admin/apps">← Back to apps</a></header><main class="form-shell"><div><span class="eyebrow">APP MANAGER</span><h1><%= item?'Edit app':'Add new app' %></h1><p>Changes to published apps appear on the homepage immediately.</p></div><form class="form-card" method="post" action="<%= item?'/admin/apps/'+item.id:'/admin/apps' %>"><div class="form-grid"><label class="span-2">App name<input name="name" value="<%= item?.name || '' %>" required></label><label>Icon / emoji<input name="icon" value="<%= item?.icon || '🚀' %>" maxlength="16"></label><label>Display order<input name="display_order" type="number" value="<%= item?.display_order ?? 100 %>"></label><label class="span-2">Description<textarea name="description" rows="4"><%= item?.description || '' %></textarea></label><label class="span-2">App URL<input name="url" type="url" value="<%= item?.url || '' %>" placeholder="https://..."></label><label>Category<select name="category_id"><option value="">Select category</option><% categories.forEach(c=>{ %><option value="<%= c.id %>" <%= Number(item?.category_id)===c.id?'selected':'' %>><%= c.name %></option><% }) %></select></label><label>Year levels<input name="year_levels" value="<%= item?.year_levels || 'All' %>" placeholder="Year 7 or Years 7–8"></label><label>Audience<input name="audience" value="<%= item?.audience || 'Students, Teachers' %>"></label><label>App type<input name="app_type" value="<%= item?.app_type || 'Learning Tool' %>"></label><label class="span-2">Tags<input name="tags" value="<%= item?.tags || '' %>" placeholder="AI, coding, assessment, workbook"></label><label>Status<select name="status"><% ['published','draft','hidden'].forEach(s=>{ %><option value="<%= s %>" <%= (item?.status||'published')===s?'selected':'' %>><%= s[0].toUpperCase()+s.slice(1) %></option><% }) %></select></label><label class="check"><input type="checkbox" name="featured" <%= item?.featured?'checked':'' %>> Featured app</label></div><div class="form-actions"><a class="ghost-btn" href="/admin/apps">Cancel</a><button class="primary-btn"><%= item?'Save Changes':'Add App' %></button></div></form></main></body></html>
