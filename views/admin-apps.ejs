<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>App Manager — EDU Apps Plus</title><link rel="stylesheet" href="/css/app.css"></head><body class="admin-bg"><header class="admin-top"><a class="brand" href="/"><span class="brand-mark">EDU</span><span>Apps Plus</span></a><div><a class="ghost-btn" href="/">View site</a><form method="post" action="/admin/logout" class="inline"><button class="ghost-btn">Sign out</button></form></div></header><main class="admin-shell"><% if(saved){ %><div class="alert"><%= saved %></div><% } %><% if(error){ %><div class="alert"><%= error %></div><% } %><% if(vercel){ %><div class="alert">Vercel admin saves require the optional GitHub environment variables. Without them, the public site still works but changes cannot be persisted.</div><% } %><div class="admin-heading"><div><span class="eyebrow">ADMIN</span><h1>App Manager</h1><p>Add, edit, publish and organise apps on the homepage.</p></div><a class="primary-btn" href="/admin/apps/new">+ Add New App</a></div><div class="table-card"><table><thead><tr><th>App</th><th>Category</th><th>Year</th><th>Status</th><th>Order</th><th></th></tr></thead><tbody><% apps.forEach(a=>{ %><tr><td><div class="app-name"><span><%= a.icon %></span><div><b><%= a.name %></b><small><%= a.featured?'Featured':'' %></small></div></div></td><td><%= a.category_name || '—' %></td><td><%= a.year_levels %></td><td><span class="status <%= a.status %>"><%= a.status %></span></td><td><%= a.display_order %></td><td class="actions"><a href="/admin/apps/<%= a.id %>/edit">Edit</a><form method="post" action="/admin/apps/<%= a.id %>/delete" onsubmit="return confirm('Delete this app?')"><button>Delete</button></form></td></tr><% }) %></tbody></table></div></main></body></html>
