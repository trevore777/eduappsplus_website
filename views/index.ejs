<%- include('partials/header',{title:'EDU Apps Plus'}) %>
<section class="hero"><div><span class="eyebrow">YOUR DIGITAL LEARNING HUB</span><h1>One place for every<br><span>EDU Apps Plus tool.</span></h1><p>Find learning, assessment, evidence and classroom apps by subject, year level or purpose.</p><div class="search-wrap"><input id="search" type="search" placeholder="Search apps, subjects or year levels…"><button type="button">Search</button></div></div><div class="hero-orbit"><div class="orb big">EDU<span>+</span></div><div class="orb o1">💻</div><div class="orb o2">📊</div><div class="orb o3">✝️</div><div class="orb o4">📋</div></div></section>

<section class="section" id="subjects"><div class="section-head"><div><span class="eyebrow">EXPLORE</span><h2>Browse by subject</h2></div><button class="chip active" data-category="all">All apps</button></div><div class="category-grid"><button class="category-card active" data-category="all"><span>✨</span><b>All Apps</b><small><%= apps.length %> apps</small></button><% categories.forEach(c=>{ %><button class="category-card" data-category="<%= c.slug %>"><span><%= c.icon %></span><b><%= c.name %></b><small><%= c.app_count %> <%= c.app_count===1?'app':'apps' %></small></button><% }) %></div></section>

<% const featured=apps.filter(a=>a.featured); %><% if(featured.length){ %><section class="section" id="featured"><span class="eyebrow">FEATURED</span><h2>Start here</h2><div class="featured-grid"><% featured.slice(0,3).forEach(a=>{ %><article class="featured-card app-card" data-category="<%= a.category_slug %>" data-search="<%= (a.name+' '+a.description+' '+a.year_levels+' '+a.category_name+' '+a.tags).toLowerCase() %>"><div class="app-icon"><%= a.icon %></div><div><span class="pill"><%= a.category_name %></span><h3><%= a.name %></h3><p><%= a.description %></p><div class="meta"><span><%= a.year_levels %></span><span><%= a.audience %></span></div><% if(a.url){ %><a class="primary-link" href="<%= a.url %>" target="_blank" rel="noopener">Open App <span>→</span></a><% } %></div></article><% }) %></div></section><% } %>

<section class="section"><div class="section-head"><div><span class="eyebrow">LIBRARY</span><h2>All EDU Apps</h2></div><div class="filter-row"><button class="year-filter active" data-year="all">All years</button><button class="year-filter" data-year="7">7</button><button class="year-filter" data-year="8">8</button><button class="year-filter" data-year="9">9</button><button class="year-filter" data-year="10">10</button><button class="year-filter" data-year="11">11</button><button class="year-filter" data-year="12">12</button></div></div><div id="appGrid" class="app-grid"><% apps.forEach(a=>{ %><article class="app-card standard-card" data-category="<%= a.category_slug %>" data-year="<%= a.year_levels %>" data-search="<%= (a.name+' '+a.description+' '+a.year_levels+' '+a.category_name+' '+a.tags).toLowerCase() %>"><div class="card-top"><div class="app-icon"><%= a.icon %></div><span class="pill"><%= a.category_name %></span></div><h3><%= a.name %></h3><p><%= a.description %></p><div class="meta"><span><%= a.year_levels %></span><span><%= a.app_type %></span></div><% if(a.url){ %><a class="secondary-link" href="<%= a.url %>" target="_blank" rel="noopener">Open App <span>→</span></a><% } else { %><span class="coming">Coming soon</span><% } %></article><% }) %></div><p id="emptyState" class="empty" hidden>No apps match your search.</p></section>
<%- include('partials/footer') %>
